# `python manage.py init --model /path/model.gguf --llama-server /path/llama-server`
# creates a complete .env with absolute paths and a fresh private model key.
# This example lists the settings used by the local installation.
APP_ENV=local
APP_BIND_HOST=127.0.0.1
APP_PORT=18080
TENANT_AUTH_MODE=client
LOCAL_ALLOWED_TENANTS=
WARMUP_TENANTS=

RAG_MODEL_RUNTIME=llama_cpp
LLM_BACKEND=llama_cpp
BASE_MODEL=local-model
LLAMA_MODEL_ID=local-model
LLAMA_BASE_URL=http://127.0.0.1:18081
LLAMA_SERVER_BIN=/absolute/path/to/llama-server
LLAMA_MODEL_PATH=/absolute/path/to/model.gguf
LLAMA_API_KEY_FILE=/absolute/path/to/workspace/run/model-api.key
LLAMA_CONTEXT_SIZE_TOKENS=4096
LLAMA_CONTEXT_RESERVE_TOKENS=256
LLAMA_N_GPU_LAYERS=0
LLAMA_THREADS=4
LLAMA_STARTUP_TIMEOUT_SECONDS=600
LLAMA_REQUEST_TIMEOUT_SECONDS=1200

RAG_DATA_DIR=/absolute/path/to/workspace
DOCS_BASE_DIR=/absolute/path/to/workspace/documents
TENANT_CONFIG_DIR=/absolute/path/to/workspace/config/tenants
CHROMA_PATH=/absolute/path/to/workspace/chroma
INGEST_EXTRACTION_AUDIT_DIR=/absolute/path/to/workspace/extraction-audit
PROJECT_X_CONVERSATION_STATE_PATH=/absolute/path/to/workspace/conversations.sqlite3
HF_HOME=/absolute/path/to/workspace/cache/huggingface

EMBED_MODEL=intfloat/multilingual-e5-large-instruct
EMBED_DEVICE=cpu
USE_RERANKER=0
CHAT_USE_RERANKER=0
ANONYMIZED_TELEMETRY=False
