# Copy to .env only after reviewing the installation guide.
# Paths are relative to the working directory. Keep user data outside Git.
DOCS_BASE_DIR=data
CHROMA_PATH=storage/chroma
TENANT_CONFIG_DIR=config/tenants

# Local client-selected tenancy is limited to a loopback binding.
APP_ENV=wsl
TENANT_AUTH_MODE=client
APP_BIND_HOST=127.0.0.1
# After choosing your own tenant IDs, list them here separated by commas.
# LOCAL_ALLOWED_TENANTS=

# Embedding model downloaded separately on first use.
EMBED_MODEL=intfloat/multilingual-e5-large-instruct
EMBED_DEVICE=cpu

# Optional persistent conversation database; directory must already exist.
# PROJECT_X_CONVERSATION_STATE_PATH=storage/conversations.sqlite

# Optional client socket override; the supervisor itself needs separate configuration.
# GEMMA_SUPERVISOR_SOCKET=run/hebrew-english-rag/supervisor.sock
